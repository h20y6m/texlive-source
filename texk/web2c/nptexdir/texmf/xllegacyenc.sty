\sys_if_engine_luatex:F {
  \sys_if_engine_xetex:F {
    \msg_new:nnn {xllegacyenc} {not-on-unicode-engine}
      {
        The~ xllegacyenc~ package~ requires~ either~ XeTeX,~ LuaTeX,~ or~ npTeX.~
        You~ won't~ need~ this~ package~ in~ other~ engines~ (namely,~ pdfTeX~
        and~ e-(u)pTeX).
      }
    \msg_warning:nn {xllegacyenc} {not-on-unicode-engine}
