mpfr_lib = static_library('mpfr',
  mpfr_sources,
  mpfr_gen_headers,
  c_args : mpfr_defines,
  cpp_args : mpfr_defines,
  include_directories : mpfr_includes,
  dependencies : [
    gmp_dep,
  ],
)


subdir('include')

mpfr_dep = declare_dependency(
  sources : mpfr_include_headers,
  include_directories : include_directories('include'),
  link_with : mpfr_lib,
  dependencies : [
    gmp_dep,
  ],
)
