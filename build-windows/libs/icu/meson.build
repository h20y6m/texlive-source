# You may freely use, modify and/or distribute this file.

subdir('include/unicode')

icu_dir = '../../../libs/icu'
icu_src = icu_dir / 'icu-src/source'

icu_version = run_command(
  find_program('get-icu-version.py'),
  icu_dir / 'version.ac',
  check: true).stdout().strip()

icu_major = icu_version.split('.')[0]

icu_static = get_option('no_icu_dll')


icu_defines = [
  '-DWIN32=1',
  # Disable some warnings. ICU gives a lot of warnings.
  '/wd4244',
  '/wd4275',
  '/wd4805',
]
if icu_static
  icu_defines += ['-DU_STATIC_IMPLEMENTATION']
endif

## stubdata

if icu_static
  icu_stubdata_lib = static_library('icustubdata',
    icu_src / 'stubdata/stubdata.cpp',
    include_directories: [icu_src / 'common'],
    c_args: icu_defines,
    cpp_args: icu_defines,
  )
else
  icu_stubdata_lib = shared_library('icustubdata',
    icu_src / 'stubdata/stubdata.cpp',
    include_directories: [icu_src / 'common'],
    c_args: icu_defines,
    cpp_args: icu_defines,
  )
endif

