icu_i18n_defines = icu_defines + [
  '-DU_I18N_IMPLEMENTATION',
]

if icu_static
  icu_i18n_lib = static_library('icui18n',
    icu_i18n_sources,
    include_directories: [icu_src / 'common'],
    c_args: icu_i18n_defines,
    cpp_args: icu_i18n_defines,
  )
else
  icu_i18n_stubdata_dll = shared_library('icui18n-stubdata',
    icu_i18n_sources,
    include_directories: [icu_src / 'common'],
    c_args: icu_i18n_defines,
    cpp_args: icu_i18n_defines,
    link_with : [
      icu_common_lib,
    ],
    version : icu_version,
  )
  icu_i18n_lib = icu_i18n_stubdata_dll
endif

## tools/toolutil

icu_toolutil_sources = [
  icu_src / 'tools/toolutil/collationinfo.cpp',
  icu_src / 'tools/toolutil/dbgutil.cpp',
  icu_src / 'tools/toolutil/denseranges.cpp',
  icu_src / 'tools/toolutil/filestrm.cpp',
  icu_src / 'tools/toolutil/filetools.cpp',
  icu_src / 'tools/toolutil/flagparser.cpp',
  icu_src / 'tools/toolutil/package.cpp',
  icu_src / 'tools/toolutil/pkg_genc.cpp',
  icu_src / 'tools/toolutil/pkg_gencmn.cpp',
  icu_src / 'tools/toolutil/pkg_icu.cpp',
  icu_src / 'tools/toolutil/pkgitems.cpp',
  icu_src / 'tools/toolutil/ppucd.cpp',
  icu_src / 'tools/toolutil/swapimpl.cpp',
  icu_src / 'tools/toolutil/toolutil.cpp',
  icu_src / 'tools/toolutil/ucbuf.cpp',
  icu_src / 'tools/toolutil/ucln_tu.cpp',
  icu_src / 'tools/toolutil/ucm.cpp',
  icu_src / 'tools/toolutil/ucmstate.cpp',
  icu_src / 'tools/toolutil/udbgutil.cpp',
  icu_src / 'tools/toolutil/unewdata.cpp',
  icu_src / 'tools/toolutil/uoptions.cpp',
  icu_src / 'tools/toolutil/uparse.cpp',
  icu_src / 'tools/toolutil/writesrc.cpp',
  icu_src / 'tools/toolutil/xmlparser.cpp',
]

icu_toolutil_defines = icu_defines + [
  '-DU_TOOLUTIL_IMPLEMENTATION',
]

if icu_static
  icu_toolutil_lib = static_library('icutu',
    icu_toolutil_sources,
    include_directories: [
      icu_src / 'common',
      icu_src / 'i18n',
    ],
    c_args: icu_toolutil_defines,
    cpp_args: icu_toolutil_defines,
  )
else
  icu_toolutil_stubdata_dll = shared_library('icutu-stubdata',
    icu_toolutil_sources,
    include_directories: [
      icu_src / 'common',
      icu_src / 'i18n',
    ],
    c_args: icu_toolutil_defines,
    cpp_args: icu_toolutil_defines,
    link_with : [
      icu_i18n_lib,
      icu_common_lib,
    ],
  )
  icu_toolutil_lib = icu_toolutil_stubdata_dll
endif

## tools/icupkg

icu_icupkg_exe = executable('icupkg',
  icu_src / 'tools/icupkg/icupkg.cpp',
  include_directories : [
    icu_src / 'common',
    icu_src / 'tools/toolutil',
  ],
  cpp_args : icu_defines,
  link_with : [
    icu_toolutil_lib,
    icu_i18n_lib,
    icu_common_lib,
    icu_stubdata_lib,
  ],
)

## tools/pkgdata

icu_pkgdata_exe = executable('pkgdata',
  icu_src / 'tools/pkgdata/pkgdata.cpp',
  icu_src / 'tools/pkgdata/pkgtypes.c',
  include_directories : [
    icu_src / 'common',
    icu_src / 'tools/toolutil',
  ],
  c_args : icu_defines,
  cpp_args : icu_defines,
  link_with : [
    icu_toolutil_lib,
    icu_i18n_lib,
    icu_common_lib,
    icu_stubdata_lib,
  ],
)

## packagedata

if host_machine.cpu_family() == 'aarch64'
  icu_packagedata_arch = 'ARM64'
elif host_machine.cpu_family() == 'arm'
  icu_packagedata_arch = 'ARM'
elif host_machine.cpu_family() == 'x86_64'
  icu_packagedata_arch = 'X64'
elif host_machine.cpu_family() == 'x86'
  icu_packagedata_arch = 'X86'
else
  error('Unsupported cpu_family.', host_machine.cpu_family())
endif

if icu_static
  icu_packagedata = custom_target('packagedata',
    input : [
      icu_src / f'data/in/icudt@icu_major@l.dat',
    ],
    output : [
      'icudt.lib',
    ],
    command : [
      find_program('makedata.py'),
      '--workdir', '@PRIVATE_DIR@',
      '--outdir', '@OUTDIR@',
      '--icupkg', icu_icupkg_exe,
      '--pkgdata', icu_pkgdata_exe,
      '--arch', icu_packagedata_arch,
      '--mode', 'static',
      '--version', icu_major,
      '@INPUT@',
    ],
  )
else
  icu_packagedata = custom_target('packagedata',
    input : [
      icu_src / f'data/in/icudt@icu_major@l.dat',
    ],
    output : [
      'icudt.lib',
      f'icudt@icu_major@.dll',
    ],
    command : [
      find_program('makedata.py'),
      '--workdir', '@PRIVATE_DIR@',
      '--outdir', '@OUTDIR@',
      '--icupkg', icu_icupkg_exe,
      '--pkgdata', icu_pkgdata_exe,
      '--arch', icu_packagedata_arch,
      '--mode', 'dll',
      '--version', icu_major,
      '@INPUT@',
    ],
    install : true,
    install_dir : [false, get_option('bindir')],
  )
endif

## rebuild DLL with non-stub data

if not icu_static
  icu_common_dll = shared_library('icuuc',
    objects: icu_common_stubdata_dll.extract_all_objects(recursive : false), # reuse built objects
    link_with : [
      icu_packagedata[0],
    ],
    version : icu_version,
    install : true,
  )
  icu_i18n_dll = shared_library('icui18n',
    objects: icu_i18n_stubdata_dll.extract_all_objects(recursive : false), # reuse built objects
    link_with : [
      icu_common_dll,
      icu_packagedata[0],
    ],
    version : icu_version,
    install : true,
  )
endif


## declare_dependency

if icu_static
  icu_dep = declare_dependency(
    sources: [
      icu_public_headers,
      icu_packagedata,
    ],
    include_directories: include_directories(
      'include',
    ),
    compile_args: ['-DU_STATIC_IMPLEMENTATION'],
    link_with: [
      icu_common_lib,
      icu_i18n_lib,
      icu_packagedata,
    ],
  )
else
  icu_dep = declare_dependency(
    sources: [
      icu_public_headers,
    ],
    include_directories: include_directories(
      'include',
    ),
    compile_args: [],
    link_with: [
      icu_common_dll,
      icu_i18n_dll,
    ],
  )
endif
