dvipdfmx_srcdir = '../../../texk/dvipdfm-x'

dvipdfmx_version = run_command(
    find_program('get-dvipdfmx-version.py'), dvipdfmx_srcdir / 'configure.ac',
    check: true).stdout().strip()


dvipdfmx_gen_headers = []

dvipdfmx_gen_headers += configure_file(
  input : 'config.h.in',
  output : 'config.h',
  configuration : {
    'VERSION' : dvipdfmx_version,
  }
)


dvipdfmx_includes = include_directories(
  dvipdfmx_srcdir,
)

dvipdfmx_defines = [
  '-DWIN32=1',
  '-DW32TEX=1',
  '-DKPATHSEA=1',
  '-DHAVE_CONFIG_H=1',
  '-D_CRT_NONSTDC_NO_DEPRECATE',
  '-D_CRT_SECURE_NO_DEPRECATE',
]


dvipdfmx_sources = [
  dvipdfmx_srcdir / 'agl.c',
  dvipdfmx_srcdir / 'agl.h',
  dvipdfmx_srcdir / 'bmpimage.c',
  dvipdfmx_srcdir / 'bmpimage.h',
  dvipdfmx_srcdir / 'cff.c',
  dvipdfmx_srcdir / 'cff.h',
  dvipdfmx_srcdir / 'cff_dict.c',
  dvipdfmx_srcdir / 'cff_dict.h',
  dvipdfmx_srcdir / 'cff_limits.h',
  dvipdfmx_srcdir / 'cff_stdstr.h',
  dvipdfmx_srcdir / 'cff_types.h',
  dvipdfmx_srcdir / 'cid_basefont.h',
  dvipdfmx_srcdir / 'cid.c',
