  dvipdfmx_srcdir / 'pdfresource.c',
  dvipdfmx_srcdir / 'pdfresource.h',
  dvipdfmx_srcdir / 'pdfximage.c',
  dvipdfmx_srcdir / 'pdfximage.h',
  dvipdfmx_srcdir / 'pkfont.c',
  dvipdfmx_srcdir / 'pkfont.h',
  dvipdfmx_srcdir / 'pngimage.c',
  dvipdfmx_srcdir / 'pngimage.h',
  dvipdfmx_srcdir / 'pst.c',
  dvipdfmx_srcdir / 'pst.h',
  dvipdfmx_srcdir / 'pst_obj.c',
  dvipdfmx_srcdir / 'pst_obj.h',
  dvipdfmx_srcdir / 'sfnt.c',
  dvipdfmx_srcdir / 'sfnt.h',
  dvipdfmx_srcdir / 'spc_color.c',
  dvipdfmx_srcdir / 'spc_color.h',
  dvipdfmx_srcdir / 'spc_dvipdfmx.c',
  dvipdfmx_srcdir / 'spc_dvipdfmx.h',
  dvipdfmx_srcdir / 'spc_dvips.c',
  dvipdfmx_srcdir / 'spc_dvips.h',
  dvipdfmx_srcdir / 'spc_html.c',
  dvipdfmx_srcdir / 'spc_html.h',
  dvipdfmx_srcdir / 'spc_misc.c',
  dvipdfmx_srcdir / 'spc_misc.h',
  dvipdfmx_srcdir / 'spc_pdfm.c',
  dvipdfmx_srcdir / 'spc_pdfm.h',
  dvipdfmx_srcdir / 'spc_tpic.c',
  dvipdfmx_srcdir / 'spc_tpic.h',
  dvipdfmx_srcdir / 'spc_util.h',
