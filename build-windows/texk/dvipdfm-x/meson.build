  dvipdfmx_srcdir / 'pdfcolor.h',
  dvipdfmx_srcdir / 'pdfdev.c',
  dvipdfmx_srcdir / 'pdfdev.h',
  dvipdfmx_srcdir / 'pdfdoc.c',
  dvipdfmx_srcdir / 'pdfdoc.h',
  dvipdfmx_srcdir / 'pdfdraw.c',
  dvipdfmx_srcdir / 'pdfdraw.h',
  dvipdfmx_srcdir / 'pdfencrypt.c',
