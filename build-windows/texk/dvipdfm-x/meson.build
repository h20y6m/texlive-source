  dvipdfmx_srcdir / 'system.h',
  dvipdfmx_srcdir / 't1_char.c',
  dvipdfmx_srcdir / 't1_char.h',
  dvipdfmx_srcdir / 't1_load.c',
  dvipdfmx_srcdir / 't1_load.h',
  dvipdfmx_srcdir / 'tfm.c',
  dvipdfmx_srcdir / 'tfm.h',
  dvipdfmx_srcdir / 'truetype.c',
  dvipdfmx_srcdir / 'truetype.h',
  dvipdfmx_srcdir / 'tt_aux.c',
  dvipdfmx_srcdir / 'tt_aux.h',
  dvipdfmx_srcdir / 'tt_cmap.c',
  dvipdfmx_srcdir / 'tt_cmap.h',
  dvipdfmx_srcdir / 'tt_glyf.c',
  dvipdfmx_srcdir / 'tt_glyf.h',
  dvipdfmx_srcdir / 'tt_gsub.c',
  dvipdfmx_srcdir / 'tt_gsub.h',
  dvipdfmx_srcdir / 'tt_post.c',
  dvipdfmx_srcdir / 'tt_post.h',
  dvipdfmx_srcdir / 'tt_table.c',
  dvipdfmx_srcdir / 'tt_table.h',
  dvipdfmx_srcdir / 'type0.c',
  dvipdfmx_srcdir / 'type0.h',
  dvipdfmx_srcdir / 'type1.c',
  dvipdfmx_srcdir / 'type1.h',
  dvipdfmx_srcdir / 'type1c.c',
  dvipdfmx_srcdir / 'type1c.h',
  dvipdfmx_srcdir / 'unicode.c',
  dvipdfmx_srcdir / 'unicode.h',
  dvipdfmx_srcdir / 'vf.c',
  dvipdfmx_srcdir / 'vf.h',
  dvipdfmx_srcdir / 'xbb.c',
]


dvipdfmx_dll = shared_library('dvipdfmx',
  dvipdfmx_sources,
  dvipdfmx_gen_headers,
  c_args : dvipdfmx_defines,
  include_directories : dvipdfmx_includes,
  dependencies : [
    kpathsea_dep,
    libpaper_dep,
    libpng_dep,
  ],
  install : true,
)

call_dvipdfmx_exe = executable('call-dvipdfmx',
  '../calldll/calldll.c',
  c_args : '-DDLLPROC=dlldvipdfmxmain',
  link_with: dvipdfmx_dll,
)

foreach exe : ['xdvipdfmx.exe', 'dvipdfmx.exe', 'dvipdfm.exe']
  custom_target(exe,
    input: call_dvipdfmx_exe,
    output: exe,
    command: [copyfile_py, '@INPUT@', '@OUTPUT@'],
    build_by_default : true,
    install : true,
    install_dir : get_option('bindir'),
  )
endforeach
