  dvipdfmx_srcdir / 'dpxcrypt.h',
  dvipdfmx_srcdir / 'dpxfile.c',
  dvipdfmx_srcdir / 'dpxfile.h',
  dvipdfmx_srcdir / 'dpxutil.c',
  dvipdfmx_srcdir / 'dpxutil.h',
  dvipdfmx_srcdir / 'dvi.c',
  dvipdfmx_srcdir / 'dvi.h',
